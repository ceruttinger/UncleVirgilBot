(function () {
  const graphEl = document.getElementById("entity-graph");
  const detailsEl = document.getElementById("entity-graph-details");
  const typeFilterEl = document.getElementById("entity-type-filter");
  const minCountEl = document.getElementById("entity-min-count");
  const resetEl = document.getElementById("entity-graph-reset");

  if (!graphEl) return;

  function nodeColorGroup(type) {
    return type || "Entity";
  }

  function countFromTitle(title) {
    if (!title) return 1;
    const match = String(title).match(/Total mentions:\s*(\d+)/i);
    return match ? Number(match[1]) : 1;
  }

  Promise.all([
    fetch("data/public/graph_nodes.json").then((r) => r.json()),
    fetch("data/public/graph_edges.json").then((r) => r.json())
  ])
    .then(([rawNodes, rawEdges]) => {
      if (typeof vis === "undefined") {
        graphEl.innerHTML = "Graph library did not load. Check your internet connection or CDN access.";
        return;
      }

      const allNodes = rawNodes.map((n) => ({
        id: n.id,
        label: n.short_label || n.label,
        fullLabel: n.label,
        group: nodeColorGroup(n.group || n.type),
        type: n.type,
        title: n.title || n.label,
        value: Number(n.value || 10),
        totalMentions: countFromTitle(n.title),
        shape: n.type === "Chapter" ? "box" : "dot",
        font: { multi: "html" }
      }));

      const allEdges = rawEdges.map((e) => ({
        from: e.from,
        to: e.to,
        value: Number(e.weight || 1),
        title: e.title || e.relationship,
        relationship: e.relationship,
        arrows: e.relationship === "MENTIONS" ? "to" : "",
        smooth: { type: "dynamic" }
      }));

      const types = Array.from(new Set(allNodes.map((n) => n.type).filter((t) => t && t !== "Chapter"))).sort();
      if (typeFilterEl) {
        typeFilterEl.innerHTML = '<option value="All">All entity types</option>' +
          types.map((t) => `<option value="${t}">${t}</option>`).join("");
      }

      const container = graphEl;
      let network = null;

      function render() {
        const selectedType = typeFilterEl ? typeFilterEl.value : "All";
        const minCount = minCountEl ? Number(minCountEl.value || 1) : 1;

        const visibleEntityIds = new Set(
          allNodes
            .filter((n) => n.type === "Chapter" ||
              ((selectedType === "All" || n.type === selectedType) && n.totalMentions >= minCount))
            .map((n) => n.id)
        );

        const visibleEdges = allEdges.filter((e) => visibleEntityIds.has(e.from) && visibleEntityIds.has(e.to));
        const connectedIds = new Set();
        visibleEdges.forEach((e) => {
          connectedIds.add(e.from);
          connectedIds.add(e.to);
        });

        const visibleNodes = allNodes.filter((n) => visibleEntityIds.has(n.id) && (n.type === "Chapter" || connectedIds.has(n.id)));

        const data = {
          nodes: new vis.DataSet(visibleNodes),
          edges: new vis.DataSet(visibleEdges)
        };

        const options = {
          layout: { improvedLayout: true },
          physics: {
            stabilization: true,
            barnesHut: {
              gravitationalConstant: -18000,
              centralGravity: 0.25,
              springLength: 150,
              springConstant: 0.04,
              damping: 0.25
            }
          },
          interaction: {
            hover: true,
            tooltipDelay: 120,
            navigationButtons: true,
            keyboard: true
          },
          nodes: {
            borderWidth: 1,
            shadow: true
          },
          edges: {
            shadow: false,
            scaling: { min: 1, max: 8 }
          },
          groups: {
            Chapter: { shape: "box" },
            Person: { shape: "dot" },
            Place: { shape: "triangle" },
            Organization: { shape: "diamond" },
            "Organization/Place": { shape: "star" },
            Event: { shape: "hexagon" },
            Date: { shape: "square" }
          }
        };

        network = new vis.Network(container, data, options);
        network.on("click", function (params) {
          if (!detailsEl) return;
          if (params.nodes && params.nodes.length > 0) {
            const node = visibleNodes.find((n) => n.id === params.nodes[0]);
            detailsEl.innerHTML = node ? node.title : "";
          } else {
            detailsEl.innerHTML = "Click a chapter or entity to inspect it.";
          }
        });
      }

      if (typeFilterEl) typeFilterEl.addEventListener("change", render);
      if (minCountEl) minCountEl.addEventListener("input", render);
      if (resetEl) resetEl.addEventListener("click", function () {
        if (typeFilterEl) typeFilterEl.value = "All";
        if (minCountEl) minCountEl.value = 3;
        render();
      });

      render();
    })
    .catch((err) => {
      console.error(err);
      graphEl.innerHTML = "Could not load graph data. Run Rscript R/render_all.R and refresh this page.";
    });
})();
