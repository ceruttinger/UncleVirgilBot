suppressPackageStartupMessages({
  library(readr)
  library(dplyr)
  library(tidyr)
  library(stringr)
  library(purrr)
  library(jsonlite)
})

message("Building entity graph data...")

registry_path <- "data/processed/entity_registry.csv"
mentions_path <- "data/processed/entity_mentions.csv"
metadata_path <- "data/chapter_metadata.csv"

if (!file.exists(registry_path)) {
  stop("Missing ", registry_path, ". Run R/09_extract_named_entities.R first.")
}
if (!file.exists(metadata_path)) {
  stop("Missing ", metadata_path, ".")
}

registry <- readr::read_csv(registry_path, show_col_types = FALSE) |>
  mutate(
    entity_id = as.character(entity_id),
    canonical_entity = as.character(canonical_entity),
    entity_type = as.character(entity_type),
    review_status = if_else(is.na(review_status), "", as.character(review_status)),
    total_count = suppressWarnings(as.numeric(total_count)),
    total_count = if_else(is.na(total_count), 0, total_count)
  ) |>
  filter(
    !is.na(entity_id), entity_id != "",
    !is.na(canonical_entity), canonical_entity != "",
    entity_type != "Unclassified",
    review_status != "rejected",
    total_count > 0
  )

chapter_meta <- readr::read_csv(metadata_path, show_col_types = FALSE) |>
  mutate(chapter = suppressWarnings(as.integer(chapter))) |>
  filter(!is.na(chapter), chapter != 12)

if (!"chapter_title" %in% names(chapter_meta)) {
  chapter_meta$chapter_title <- paste("Chapter", chapter_meta$chapter)
}
if (!"approx_start_year" %in% names(chapter_meta)) chapter_meta$approx_start_year <- NA_integer_
if (!"approx_end_year" %in% names(chapter_meta)) chapter_meta$approx_end_year <- NA_integer_
if (!"life_stage" %in% names(chapter_meta)) chapter_meta$life_stage <- NA_character_
if (!"primary_locations" %in% names(chapter_meta)) chapter_meta$primary_locations <- NA_character_

# Keep all accepted seed entities, plus reasonably frequent candidate entities.
# This avoids a hairball while still showing the memoir's important people/places/orgs/dates.
graph_registry <- registry |>
  filter(
    review_status %in% c("accepted", "") |
      (review_status == "candidate" & total_count >= 2)
  ) |>
  arrange(entity_type, desc(total_count), canonical_entity)

# Build mentions from entity_mentions.csv when possible. Fall back to registry$chapters.
make_edges_from_registry <- function(reg) {
  reg |>
    select(entity_id, canonical_entity, entity_type, total_count, chapters) |>
    mutate(chapters = if_else(is.na(chapters), "", chapters)) |>
    tidyr::separate_rows(chapters, sep = "\\s*;\\s*") |>
    mutate(
      chapter = suppressWarnings(as.integer(chapters)),
      count = pmax(1, ceiling(total_count / pmax(1, str_count(chapters, ";") + 1)))
    ) |>
    filter(!is.na(chapter), chapter != 12) |>
    select(chapter, entity_id, canonical_entity, entity_type, count)
}

if (file.exists(mentions_path)) {
  mentions_raw <- readr::read_csv(mentions_path, show_col_types = FALSE)
  names_lower <- tolower(names(mentions_raw))

  chapter_col <- names(mentions_raw)[match(TRUE, names_lower %in% c("chapter", "chapter_number", "chapter_id"))]
  entity_id_col <- names(mentions_raw)[match(TRUE, names_lower %in% c("entity_id", "id"))]
  canonical_col <- names(mentions_raw)[match(TRUE, names_lower %in% c("canonical_entity", "entity", "entity_text", "name"))]
  type_col <- names(mentions_raw)[match(TRUE, names_lower %in% c("entity_type", "type"))]
  count_col <- names(mentions_raw)[match(TRUE, names_lower %in% c("count", "mention_count", "mentions", "total_count"))]

  if (!is.na(chapter_col) && (!is.na(entity_id_col) || !is.na(canonical_col))) {
    mentions <- mentions_raw |>
      rename(chapter = all_of(chapter_col)) |>
      mutate(chapter = suppressWarnings(as.integer(chapter))) |>
      filter(!is.na(chapter), chapter != 12)

    if (!is.na(entity_id_col) && entity_id_col != "entity_id") {
      mentions <- mentions |> rename(entity_id = all_of(entity_id_col))
    }
    if (!"entity_id" %in% names(mentions) && !is.na(canonical_col)) {
      mentions <- mentions |>
        rename(canonical_entity = all_of(canonical_col))
      if (!is.na(type_col) && type_col != "entity_type") {
        mentions <- mentions |> rename(entity_type = all_of(type_col))
      }
      mentions <- mentions |>
        left_join(registry |> select(entity_id, canonical_entity, entity_type),
                  by = intersect(c("canonical_entity", "entity_type"), names(mentions)))
    }
    if (!is.na(count_col) && count_col != "count") {
      mentions <- mentions |> rename(count = all_of(count_col))
    }
    if (!"count" %in% names(mentions)) mentions$count <- 1

    mentions <- mentions |>
      mutate(
        entity_id = as.character(entity_id),
        count = suppressWarnings(as.numeric(count)),
        count = if_else(is.na(count), 1, count)
      ) |>
      filter(!is.na(entity_id), entity_id != "") |>
      inner_join(graph_registry |> select(entity_id, canonical_entity, entity_type), by = "entity_id") |>
      group_by(chapter, entity_id, canonical_entity, entity_type) |>
      summarise(count = sum(count, na.rm = TRUE), .groups = "drop")
  } else {
    mentions <- make_edges_from_registry(graph_registry)
  }
} else {
  mentions <- make_edges_from_registry(graph_registry)
}

mentions <- mentions |>
  filter(chapter %in% chapter_meta$chapter) |>
  group_by(chapter, entity_id, canonical_entity, entity_type) |>
  summarise(count = sum(count, na.rm = TRUE), .groups = "drop") |>
  filter(count > 0)

# Chapter nodes
chapter_nodes <- chapter_meta |>
  transmute(
    id = paste0("chapter_", chapter),
    label = paste0("Ch. ", chapter, ": ", chapter_title),
    short_label = paste0("Ch. ", chapter),
    type = "Chapter",
    group = "Chapter",
    chapter = chapter,
    title = paste0(
      "<strong>Chapter ", chapter, ": ", chapter_title, "</strong><br>",
      "Approx. years: ", coalesce(as.character(approx_start_year), "?"), "–", coalesce(as.character(approx_end_year), "?"), "<br>",
      "Life stage: ", coalesce(as.character(life_stage), ""), "<br>",
      "Primary locations: ", coalesce(as.character(primary_locations), "")
    ),
    value = 25
  )

entity_nodes <- graph_registry |>
  semi_join(mentions, by = "entity_id") |>
  transmute(
    id = entity_id,
    label = canonical_entity,
    short_label = canonical_entity,
    type = entity_type,
    group = entity_type,
    chapter = NA_integer_,
    title = paste0(
      "<strong>", canonical_entity, "</strong><br>",
      "Type: ", entity_type, "<br>",
      "Review status: ", if_else(review_status == "", "unreviewed seed", review_status), "<br>",
      "Total mentions: ", total_count, "<br>",
      "Chapters: ", chapters
    ),
    value = pmax(8, pmin(35, sqrt(total_count) * 4))
  )

nodes <- bind_rows(chapter_nodes, entity_nodes) |>
  distinct(id, .keep_all = TRUE)

edges <- mentions |>
  transmute(
    from = paste0("chapter_", chapter),
    to = entity_id,
    relationship = "MENTIONS",
    weight = count,
    title = paste0("Chapter ", chapter, " mentions ", canonical_entity, " ", count, " time(s).")
  ) |>
  filter(from %in% nodes$id, to %in% nodes$id)

# Extra lightweight chapter-to-chapter edges by shared important entities.
chapter_pairs <- mentions |>
  filter(entity_type %in% c("Person", "Place", "Organization", "Organization/Place", "Event"), count >= 2) |>
  select(chapter, entity_id) |>
  distinct() |>
  inner_join(select(., chapter_b = chapter, entity_id), by = "entity_id") |>
  filter(chapter < chapter_b) |>
  count(chapter, chapter_b, name = "shared_entities") |>
  filter(shared_entities >= 3) |>
  transmute(
    from = paste0("chapter_", chapter),
    to = paste0("chapter_", chapter_b),
    relationship = "SHARES_ENTITIES_WITH",
    weight = shared_entities,
    title = paste0("These chapters share ", shared_entities, " recurring entities.")
  )

edges_all <- bind_rows(edges, chapter_pairs) |>
  distinct(from, to, relationship, .keep_all = TRUE)

readr::write_csv(nodes, "data/public/graph_nodes.csv")
readr::write_csv(edges_all, "data/public/graph_edges.csv")
jsonlite::write_json(nodes, "data/public/graph_nodes.json", pretty = TRUE, auto_unbox = TRUE, na = "null")
jsonlite::write_json(edges_all, "data/public/graph_edges.json", pretty = TRUE, auto_unbox = TRUE, na = "null")

message("Wrote graph outputs:")
message("- data/public/graph_nodes.json")
message("- data/public/graph_edges.json")
message("- data/public/graph_nodes.csv")
message("- data/public/graph_edges.csv")
